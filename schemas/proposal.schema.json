{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMWA Increment proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "short_description"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5,
      "description": "Human-readable Increment title."
    },
    "short_description": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200,
      "description": "One-sentence description for site metadata."
    },
    "initial_maintainers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
      },
      "description": "Optional GitHub usernames of initial maintainers."
    }
  }
}
